{
  "listen": "127.0.0.1:14322",
  "public_url": "http://127.0.0.1:14322",
  "auth": {
    "mode": "oidc_or_basic",
    "issuer": "https://zitadel.example.com",
    "client_id": "av-public-client",
    "audiences": ["av-public-client"],
    "scopes": ["openid", "groups"],
    "signing_algorithms": ["RS256"],
    "allowed_groups": ["av-users"],
    "group_claim": "groups",
    "basic_users": [
      {
        "username": "break-glass",
        "password_hash_file": "/var/run/av/basic/password.argon2id"
      }
    ]
  },
  "connectors": {
    "platform": {
      "kind": "infisical",
      "base_url": "https://infisical.example.com",
      "auth": {
        "type": "kubernetes",
        "identity_id": "replace-with-existing-infisical-identity-id",
        "token_file": "/var/run/secrets/kubernetes.io/serviceaccount/token"
      }
    },
    "openbao": {
      "kind": "openbao",
      "base_url": "https://openbao.example.com",
      "namespace": "",
      "auth": {
        "type": "kubernetes",
        "role": "av",
        "token_file": "/var/run/secrets/kubernetes.io/serviceaccount/token",
        "mount_path": "kubernetes"
      }
    }
  },
  "profiles": {
    "infra": {
      "connector": "platform",
      "project_id": "existing-infrastructure-project-id",
      "environment": "prod",
      "secret_path": "/",
      "allowed_keys": []
    },
    "example-dev": {
      "connector": "platform",
      "project_id": "existing-application-project-id",
      "environment": "dev",
      "secret_path": "/",
      "allowed_keys": []
    },
    "example-prod": {
      "connector": "platform",
      "project_id": "existing-application-project-id",
      "environment": "prod",
      "secret_path": "/",
      "allowed_keys": []
    },
    "openbao-infra": {
      "connector": "openbao",
      "secret_path": "secret/data/infra",
      "allowed_keys": []
    }
  },
  "proxy_routes": {
    "cloudflare-dns": {
      "profile": "infra",
      "base_url": "https://api.cloudflare.com/client/v4",
      "secret_key": "CLOUDFLARE_API_TOKEN",
      "header": "Authorization",
      "header_prefix": "Bearer ",
      "allowed_methods": ["GET", "POST", "PUT", "PATCH"],
      "allowed_path_prefixes": ["/zones/"],
      "allowed_request_headers": ["accept", "content-type", "if-match", "if-none-match"],
      "allowed_response_headers": ["content-type", "etag", "last-modified", "retry-after"],
      "allowed_query_parameters": ["page", "per_page", "type", "name"],
      "allowed_content_types": ["application/json"],
      "max_body_bytes": 1048576
    }
  },
  "max_connector_concurrency": 16,
  "api_rate_limit_per_second": 50,
  "api_rate_limit_burst": 100
}
